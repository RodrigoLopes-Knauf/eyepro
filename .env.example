# ==========================================
# Configuração do Servidor VPS (DataGate Remote Live)
# ==========================================

# Domínio público apontado para o IP da VPS (para emissão automática de SSL Let's Encrypt)
DOMAIN=remote.seu-dominio.com

# Seu e-mail para avisos de renovação de certificado Let's Encrypt
LETSENCRYPT_EMAIL=admin@seu-dominio.com

# Porta interna exposta do servidor Node
PORT=8080

# Chave Privada do Worker (Padrão DataGate WORKER_SECRET)
# Apenas workers que possuírem esta chave conseguirão se conectar e transmitir a tela.
WORKER_SECRET=kna_sec_7f9c2e4a8b1d6f30a9e52c84d710ab9e4321
WORKER_AUTH_KEY=kna_sec_7f9c2e4a8b1d6f30a9e52c84d710ab9e4321

# URL da API do DataGate corporativo para autenticação Karl
DATAGATE_URL=https://datagate.4-rl.net
